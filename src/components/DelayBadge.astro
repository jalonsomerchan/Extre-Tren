---
import type { TrainRecord } from '../data/delays';
import { getDelayState, getDisplayedDelay } from '../data/delays';
import type { Locale } from '../config/site';
import { useTranslations } from '../i18n/ui';

interface Props {
  record: TrainRecord;
  locale: Locale;
}

const { record, locale } = Astro.props;
const t = useTranslations(locale);
const state = getDelayState(record);
const displayedDelay = getDisplayedDelay(record);
const delay = displayedDelay === null ? '' : `${displayedDelay} ${t('common.minutes')}`;
const label = state === 'onTime' ? t('status.onTime') : state === 'unknown' ? t('status.unknown') : t(`status.${state}`);
---

<span class:list={['delay-badge', `delay-badge--${state}`]} title={label}>
  {state === 'cancelled' || state === 'suspended' || state === 'unknown' ? label : `${delay} · ${label}`}
</span>

<style>
  :global(.delay-badge) {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 750;
    line-height: 1.15;
    white-space: nowrap;
  }

  :global(.delay-badge--onTime) { background: color-mix(in srgb, var(--color-delay-on-time), transparent 88%); color: var(--color-delay-on-time); }
  :global(.delay-badge--minor) { background: color-mix(in srgb, var(--color-delay-minor), transparent 86%); color: var(--color-delay-minor); }
  :global(.delay-badge--major) { background: color-mix(in srgb, var(--color-delay-major), transparent 86%); color: var(--color-delay-major); }
  :global(.delay-badge--severe) { background: color-mix(in srgb, var(--color-delay-severe), transparent 84%); color: var(--color-delay-severe); }
  :global(.delay-badge--suspended) { background: var(--color-warning-soft); color: var(--color-warning); }
  :global(.delay-badge--cancelled) { background: var(--color-text); color: var(--color-surface); }
  :global(.delay-badge--unknown) { background: var(--color-surface-soft); color: var(--color-text-muted); }
</style>
