---
import type { Locale } from '../config/site';
import { useTranslations } from '../i18n/ui';

interface Props { locale: Locale; compact?: boolean; }

const { locale, compact = false } = Astro.props;
const t = useTranslations(locale);
const states = ['onTime', 'minor', 'major', 'severe'] as const;
---

<ul class:list={['delay-legend', { 'delay-legend--compact': compact }]} aria-label={t('chart.legend')}>
  {states.map((state) => (
    <li>
      <span class:list={['delay-legend__swatch', `is-${state}`]} aria-hidden="true"></span>
      <strong>{t(`chart.range.${state}`)}</strong>
      <span>{t(`status.${state}`)}</span>
    </li>
  ))}
</ul>

<style>
  .delay-legend { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3) var(--space-4); padding: 0; margin: 0; list-style: none; }
  li { display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: 0.4rem; min-width: 0; color: var(--color-text-muted); font-size: 0.75rem; }
  strong { color: var(--color-text); font-weight: 750; white-space: nowrap; }
  .delay-legend__swatch { width: 0.62rem; height: 0.62rem; border-radius: 0.18rem; background: var(--delay-color); }
  .is-onTime { --delay-color: var(--color-delay-on-time); }
  .is-minor { --delay-color: var(--color-delay-minor); }
  .is-major { --delay-color: var(--color-delay-major); }
  .is-severe { --delay-color: var(--color-delay-severe); }
  .delay-legend--compact li { grid-template-columns: auto 1fr; }
  .delay-legend--compact li > span:last-child { display: none; }

  @media (min-width: 720px) {
    .delay-legend { grid-template-columns: repeat(4, minmax(0, auto)); }
  }
</style>
