---
import DelayLegend from './DelayLegend.astro';
import type { Locale } from '../config/site';
import { getDelayStateForMinutes } from '../data/delays';

interface Item { label: string; value: number; detail: string; href?: string; }
interface Props { title: string; items: Item[]; locale: Locale; }

const { title, items, locale } = Astro.props;
const maxValue = Math.max(...items.map((item) => item.value), 1);
const height = (value: number) => `${value === 0 ? 0.3 : 0.45 + (value / maxValue) * 6.2}rem`;
---

<section class="delay-trend" aria-label={title}>
  <div class="delay-trend__heading"><h2>{title}</h2><span>({items.length})</span></div>
  <ol class="delay-trend__plot">
    {items.map((item) => {
      const state = getDelayStateForMinutes(item.value);
      const content = (
        <>
          <strong>{item.detail}</strong>
          <span class="delay-trend__column" aria-hidden="true"><span class={`delay-trend__bar is-${state}`} style={`height: ${height(item.value)}`}></span></span>
          <small>{item.label}</small>
        </>
      );
      return <li>{item.href ? <a class="delay-trend__item" href={item.href}>{content}</a> : <div class="delay-trend__item">{content}</div>}</li>;
    })}
  </ol>
  <DelayLegend locale={locale} compact />
</section>

<style>
  .delay-trend { min-width: 0; padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: var(--color-surface); }
  .delay-trend__heading { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); }
  h2 { margin: 0; font-size: 1rem; letter-spacing: -0.025em; }
  .delay-trend__heading span { color: var(--color-text-soft); font-size: 0.72rem; }
  .delay-trend__plot { display: grid; grid-auto-columns: minmax(2.5rem, 1fr); grid-auto-flow: column; align-items: end; gap: var(--space-2); height: 13rem; padding: var(--space-6) 0 var(--space-4); margin: 0 0 var(--space-5); overflow-x: auto; border-bottom: 1px solid var(--color-border); list-style: none; }
  li { height: 100%; min-width: 0; }
  .delay-trend__item { display: grid; grid-template-rows: 1.3rem minmax(0, 1fr) 1.4rem; align-items: end; height: 100%; min-width: 0; color: inherit; text-align: center; text-decoration: none; }
  strong { color: var(--delay-color, var(--color-text)); font-size: 0.7rem; font-variant-numeric: tabular-nums; }
  .delay-trend__column { display: flex; width: 100%; height: 100%; align-items: end; justify-content: center; }
  .delay-trend__bar { width: min(100%, 2rem); min-height: 0.25rem; border-radius: 0.3rem 0.3rem 0 0; background: var(--delay-color); }
  small { overflow: hidden; color: var(--color-text-muted); font-size: 0.66rem; text-overflow: ellipsis; white-space: nowrap; }
  .delay-trend__item:hover small, .delay-trend__item:focus-visible small { color: var(--color-primary); text-decoration: underline; }
  .is-onTime { --delay-color: var(--color-delay-on-time); }
  .is-minor { --delay-color: var(--color-delay-minor); }
  .is-major { --delay-color: var(--color-delay-major); }
  .is-severe { --delay-color: var(--color-delay-severe); }
  .is-unknown { --delay-color: var(--color-text-soft); }
</style>
