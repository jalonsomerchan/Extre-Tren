---
import Container from './Container.astro';
import { sections, type SectionId } from '../config/navigation';
import { localeLabels, siteConfig, type Locale } from '../config/site';
import { getAlternateLocales, getLocalizedPath, useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  currentSection?: SectionId;
}

const { locale, currentSection } = Astro.props;
const t = useTranslations(locale);
const alternateLocales = getAlternateLocales(locale);
---

<header class="site-header">
  <Container class="site-header__bar">
    <a class="site-brand" href={getLocalizedPath('/', locale)} aria-label={siteConfig.name}>
      <span aria-hidden="true">↠</span>{siteConfig.name}
    </a>
    <div class="site-header__tools">
      <button class="theme-toggle" type="button" data-theme-toggle data-dark-label={t('theme.toggle')} data-light-label={t('theme.toggleLight')} aria-label={t('theme.toggle')} title={t('theme.toggle')}>◐</button>
      {alternateLocales.map((alternateLocale) => (
        <a class="language-link" href={getLocalizedPath(currentSection ? sections.find((section) => section.id === currentSection)?.path ?? '/' : '/', alternateLocale)} hreflang={alternateLocale}>
          {localeLabels[alternateLocale].slice(0, 2).toUpperCase()}
        </a>
      ))}
    </div>
  </Container>
  <Container class="site-nav-wrap">
    <nav class="site-nav" aria-label={t('nav.main')}>
      {sections.map((section) => (
        <a
          class:list={{ 'is-current': section.id === currentSection }}
          href={getLocalizedPath(section.path, locale)}
          aria-current={section.id === currentSection ? 'page' : undefined}
        >{t(section.label)}</a>
      ))}
    </nav>
  </Container>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector('[data-theme-toggle]');
  const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
  const savedTheme = localStorage.getItem('extretren-theme');

  function applyTheme(theme) {
    root.dataset.theme = theme;
    window.dispatchEvent(new CustomEvent('extretren:themechange', { detail: theme }));
    const label = theme === 'dark' ? button?.dataset.lightLabel : button?.dataset.darkLabel;
    if (label) {
      button?.setAttribute('aria-label', label);
      button?.setAttribute('title', label);
    }
  }

  applyTheme(savedTheme ?? (mediaQuery.matches ? 'dark' : 'light'));
  button?.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    localStorage.setItem('extretren-theme', nextTheme);
    applyTheme(nextTheme);
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: var(--z-header); border-bottom: 1px solid color-mix(in srgb, var(--color-border), transparent 20%); background: color-mix(in srgb, var(--color-bg), transparent 8%); backdrop-filter: blur(16px); }
  .site-header__bar { display: flex; min-height: 3.8rem; align-items: center; gap: var(--space-3); }
  .site-brand { display: inline-flex; align-items: center; gap: 0.35rem; margin-right: auto; color: var(--color-text); font-size: 1.1rem; font-weight: 850; letter-spacing: -0.05em; text-decoration: none; }
  .site-brand span { color: var(--color-primary); font-size: 1.5rem; }
  .site-header__tools { display: flex; align-items: center; gap: var(--space-2); }
  .theme-toggle, .language-link { display: grid; width: 2.35rem; height: 2.35rem; place-items: center; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-text); font: inherit; font-size: 0.75rem; font-weight: 800; text-decoration: none; cursor: pointer; }
  .theme-toggle:hover, .language-link:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .site-nav-wrap { overflow: hidden; border-top: 1px solid color-mix(in srgb, var(--color-border), transparent 35%); }
  .site-nav { display: flex; gap: var(--space-2); width: max-content; max-width: 100%; overflow-x: auto; padding-block: var(--space-2); scrollbar-width: none; }
  .site-nav::-webkit-scrollbar { display: none; }
  .site-nav a { flex: 0 0 auto; padding: 0.45rem 0.65rem; border-radius: var(--radius-full); color: var(--color-text-muted); font-size: 0.82rem; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .site-nav a:hover, .site-nav a.is-current { background: var(--color-primary-soft); color: var(--color-primary); }
</style>
