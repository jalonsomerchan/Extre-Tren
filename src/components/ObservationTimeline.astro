---
import type { TrainObservation } from '../data/delays';
import { getDelayStateForMinutes } from '../data/delays';
import type { Locale } from '../config/site';
import { useTranslations } from '../i18n/ui';

interface Props {
  observations: TrainObservation[];
  locale: Locale;
}

const { observations, locale } = Astro.props;
const t = useTranslations(locale);
const timeFormatter = new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-GB', {
  hour: '2-digit',
  minute: '2-digit',
  second: '2-digit',
  timeZone: 'Europe/Madrid',
});
const delayLabel = (delay: number | null) => delay === null ? t('status.unknown') : `${delay} ${t('common.minutes')}`;
const maxDelay = Math.max(...observations.map(([, delay]) => delay ?? 0), 1);
---

<section class="observation-timeline" aria-labelledby="observation-timeline-title">
  <h2 id="observation-timeline-title">{t('journeyDay.timeline')}</h2>
  <p>{t('journeyDay.timelineDescription')}</p>
  <ol>
    {observations.map(([observedAt, delayMinutes]) => (
      <li class={`is-${getDelayStateForMinutes(delayMinutes)}`}>
        <time datetime={observedAt}>{timeFormatter.format(new Date(observedAt))}</time>
        <span class="observation-meter" aria-hidden="true"><span style={`width: ${Math.max(3, ((delayMinutes ?? 0) / maxDelay) * 100)}%`}></span></span>
        <strong>{delayLabel(delayMinutes)}</strong>
      </li>
    ))}
  </ol>
</section>

<style>
  .observation-timeline { margin-top: var(--space-6); }
  h2 { margin: 0; font-size: 1.05rem; letter-spacing: -0.02em; }
  p { margin: var(--space-2) 0 var(--space-4); color: var(--color-text-muted); font-size: 0.9rem; }
  ol { display: grid; gap: 0; max-height: 34rem; padding: 0; margin: 0; overflow: auto; list-style: none; }
  li { display: grid; grid-template-columns: minmax(6.8rem, auto) minmax(4rem, 1fr) auto; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); border-left: 3px solid var(--delay-color); background: var(--color-surface); font-size: 0.88rem; }
  li + li { border-top: 1px solid var(--color-border); }
  ol { overflow: hidden auto; border: 1px solid var(--color-border); border-radius: var(--radius-xl); }
  time { color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  strong { color: var(--delay-color); font-variant-numeric: tabular-nums; }
  .observation-meter { height: 0.42rem; overflow: hidden; border-radius: var(--radius-sm); background: var(--color-surface-soft); }
  .observation-meter span { display: block; height: 100%; border-radius: inherit; background: var(--delay-color); }
  .is-onTime { --delay-color: var(--color-delay-on-time); }
  .is-minor { --delay-color: var(--color-delay-minor); }
  .is-major { --delay-color: var(--color-delay-major); }
  .is-severe { --delay-color: var(--color-delay-severe); }
  .is-unknown { --delay-color: var(--color-text-soft); }
</style>
