---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="page-hero">
  <p>{eyebrow}</p>
  <h1>{title}</h1>
  <p class="page-hero__description">{description}</p>
</header>

<style>
  .page-hero {
    width: 100%;
    padding-block: var(--space-8) var(--space-3);
  }

  .page-hero > p:first-child {
    margin: 0 0 var(--space-2);
    color: var(--color-primary);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    width: 100%;
    margin: 0;
    max-width: none;
    font-size: clamp(1.9rem, 5vw, 2.4rem);
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  .page-hero__description {
    max-width: 62ch;
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .page-hero { padding-block: var(--space-8) var(--space-4); }
  }
</style>
