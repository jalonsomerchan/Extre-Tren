---
interface Option {
  label: string;
  href: string;
  selected: boolean;
}

interface Props {
  label: string;
  options: Option[];
}

const { label, options } = Astro.props;
---

<div class="period-picker">
  <label>
    <span>{label}</span>
    <select data-period-picker>
      {options.map((option) => <option value={option.href} selected={option.selected}>{option.label}</option>)}
    </select>
  </label>
</div>

<script>
  document.querySelectorAll('[data-period-picker]').forEach((picker) => {
    picker.addEventListener('change', () => {
      window.location.assign(picker.value);
    });
  });
</script>

<style>
  .period-picker { margin-bottom: var(--space-5); }
  label { display: grid; gap: var(--space-2); width: min(100%, 22rem); color: var(--color-text-muted); font-size: 0.82rem; font-weight: 750; }
  select { width: 100%; min-height: 2.8rem; padding: 0.65rem 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-text); font: inherit; }
</style>
