---
interface Item {
  label: string;
  value: number;
  detail: string;
  href?: string;
}

interface Props {
  title: string;
  items: Item[];
}

const { title, items } = Astro.props;
const maxValue = Math.max(...items.map((item) => item.value), 1);
---

<section class="summary-bars" aria-labelledby="summary-bars-title">
  <h2 id="summary-bars-title">{title}</h2>
  <ol>
    {items.map((item) => (
      <li>
        {item.href ? (
          <a href={item.href}>
            <div class="summary-bars__label"><span>{item.label}</span><strong>{item.detail}</strong></div>
            <div class="summary-bars__track" aria-hidden="true"><span style={`width: ${(item.value / maxValue) * 100}%`}></span></div>
          </a>
        ) : (
          <>
            <div class="summary-bars__label"><span>{item.label}</span><strong>{item.detail}</strong></div>
            <div class="summary-bars__track" aria-hidden="true"><span style={`width: ${(item.value / maxValue) * 100}%`}></span></div>
          </>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .summary-bars { padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: var(--color-surface); box-shadow: var(--shadow-xs); }
  h2 { margin: 0; font-size: 1rem; letter-spacing: -0.02em; }
  ol { display: grid; gap: var(--space-4); padding: 0; margin: var(--space-5) 0 0; list-style: none; }
  a { display: block; border-radius: var(--radius-sm); text-decoration: none; }
  a:hover .summary-bars__label span, a:focus-visible .summary-bars__label span { color: var(--color-primary); text-decoration: underline; }
  .summary-bars__label { display: flex; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-2); color: var(--color-text-muted); font-size: 0.85rem; }
  .summary-bars__label strong { color: var(--color-text); white-space: nowrap; }
  .summary-bars__track { height: 0.48rem; overflow: hidden; border-radius: var(--radius-full); background: var(--color-surface-soft); }
  .summary-bars__track span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--color-primary), var(--color-secondary)); }
</style>
