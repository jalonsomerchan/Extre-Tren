---
import type { TrainRecord } from '../data/delays';
import { getDelayState, getDisplayedDelay } from '../data/delays';
import type { Locale } from '../config/site';
import { getLocalizedPath, useTranslations } from '../i18n/ui';
import DelayBadge from './DelayBadge.astro';

interface Props {
  records: TrainRecord[];
  locale: Locale;
  compact?: boolean;
  grouped?: boolean;
}

const { records, locale, compact = false, grouped = false } = Astro.props;
const t = useTranslations(locale);
const visibleRecords = compact ? records.slice(0, 8) : records;
const dateFormatter = new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
const updatedFormatter = new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-GB', {
  day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid',
});
const formatDeparture = (value: string) => {
  const match = value.match(/^(\d{1,2}):(\d{2})/);
  return match ? `${match[1].padStart(2, '0')}:${match[2]}` : '—';
};
const trainColumnLabel = grouped ? t('table.trainCount') : t('table.train');
---

<div class="station-board-wrap" tabindex="0">
  <table class="station-board" data-sortable-table>
    <thead>
      <tr>
        <th scope="col" aria-sort="none"><button type="button" data-sort-key="route" data-sort-type="text">{t('table.route')}<span aria-hidden="true">↕</span></button></th>
        <th scope="col" aria-sort="none"><button type="button" data-sort-key="departure" data-sort-type="text">{t('table.departure')}<span aria-hidden="true">↕</span></button></th>
        <th scope="col" aria-sort="none"><button type="button" data-sort-key="train" data-sort-type="text">{trainColumnLabel}<span aria-hidden="true">↕</span></button></th>
        <th scope="col" aria-sort="none"><button type="button" data-sort-key="delay" data-sort-type="number">{t('table.delay')}<span aria-hidden="true">↕</span></button></th>
        <th scope="col" aria-sort="none"><button type="button" data-sort-key="updated" data-sort-type="text">{t('table.updated')}<span aria-hidden="true">↕</span></button></th>
      </tr>
    </thead>
    <tbody>
      {visibleRecords.map((record) => (
        <tr
          class={`is-${getDelayState(record)}`}
          data-sort-route={`${record.origin} ${record.destination}`}
          data-sort-departure={formatDeparture(record.departure)}
          data-sort-train={record.trainNumber}
          data-sort-delay={getDisplayedDelay(record) ?? Number.POSITIVE_INFINITY}
          data-sort-updated={record.observedAt}
        >
          <td data-label={t('table.route')}>
            <a class="journey-link" href={getLocalizedPath(`/viaje/${record.trainNumber}/dia/${record.date}/`, locale)}>
              <span class="journey-link__route"><span>{record.origin}</span><span aria-hidden="true">→</span><span>{record.destination}</span></span>
              <small>{dateFormatter.format(new Date(`${record.date}T12:00:00`))}</small>
            </a>
          </td>
          <td data-label={t('table.departure')}><time class="board-time">{formatDeparture(record.departure)}</time></td>
          <td data-label={trainColumnLabel}><a class="train-link" href={getLocalizedPath(`/viaje/${record.trainNumber}/`, locale)}>{record.trainNumber}</a></td>
          <td data-label={t('table.delay')}><DelayBadge record={record} locale={locale} /></td>
          <td data-label={t('table.updated')}><time class="board-updated" datetime={record.observedAt}>{updatedFormatter.format(new Date(record.observedAt))}</time></td>
        </tr>
      ))}
    </tbody>
  </table>
  {!visibleRecords.length && <p class="station-board-empty">{t('table.empty')}</p>}
</div>

<script>
  type SortableWindow = Window & { extreTrenSortTables?: (root?: ParentNode) => void };

  const sortableWindow = window as SortableWindow;
  const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
  const getDatasetValue = (row: HTMLTableRowElement, key: string) => row.dataset[`sort${key[0].toUpperCase()}${key.slice(1)}`] ?? '';

  function setupTable(table: HTMLTableElement) {
    if (table.dataset.sortableReady) return;
    const body = table.tBodies[0];
    if (!body) return;
    table.dataset.sortableReady = 'true';
    const initialOrder = new Map([...body.rows].map((row, index) => [row, index]));

    table.querySelectorAll<HTMLButtonElement>('[data-sort-key]').forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.sortKey!;
        const type = button.dataset.sortType;
        const direction = button.dataset.sortDirection === 'asc' ? 'desc' : 'asc';
        const multiplier = direction === 'asc' ? 1 : -1;

        table.querySelectorAll<HTMLButtonElement>('[data-sort-key]').forEach((otherButton) => {
          otherButton.dataset.sortDirection = otherButton === button ? direction : '';
          otherButton.closest('th')?.setAttribute('aria-sort', otherButton === button ? direction === 'asc' ? 'ascending' : 'descending' : 'none');
          const icon = otherButton.querySelector('[aria-hidden="true"]');
          if (icon) icon.textContent = otherButton === button ? direction === 'asc' ? '↑' : '↓' : '↕';
        });

        [...body.rows]
          .sort((left, right) => {
            const leftValue = getDatasetValue(left, key);
            const rightValue = getDatasetValue(right, key);
            const comparison = type === 'number' ? Number(leftValue) - Number(rightValue) : collator.compare(leftValue, rightValue);
            return multiplier * (comparison || ((initialOrder.get(left) ?? 0) - (initialOrder.get(right) ?? 0)));
          })
          .forEach((row) => body.append(row));
      });
    });
  }

  function setupSortableTables(root: ParentNode = document) {
    root.querySelectorAll<HTMLTableElement>('table[data-sortable-table]').forEach(setupTable);
  }

  sortableWindow.extreTrenSortTables = setupSortableTables;
  setupSortableTables();
</script>

<style>
  :global(.station-board-wrap) { overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: var(--color-surface); }
  :global(.station-board) { width: 100%; border-collapse: collapse; color: var(--color-text); font-family: var(--font-sans); text-align: left; }
  :global(.station-board th), :global(.station-board td) { padding: 0.9rem 1rem; border-bottom: 1px solid var(--color-border); vertical-align: middle; }
  :global(.station-board th) { background: var(--color-surface-soft); color: var(--color-text-soft); font-size: 0.68rem; letter-spacing: 0.07em; text-transform: uppercase; white-space: nowrap; }
  :global(.station-board th button) { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; letter-spacing: inherit; text-transform: inherit; cursor: pointer; }
  :global(.station-board th button:hover), :global(.station-board th button:focus-visible) { color: var(--color-primary); }
  :global(.station-board tbody tr) { transition: background-color var(--transition-base); }
  :global(.station-board tbody tr) { box-shadow: inset 0.28rem 0 var(--row-state-color, transparent); }
  :global(.station-board tbody tr.is-onTime) { --row-state-color: var(--color-delay-on-time); }
  :global(.station-board tbody tr.is-minor) { --row-state-color: var(--color-delay-minor); }
  :global(.station-board tbody tr.is-major) { --row-state-color: var(--color-delay-major); }
  :global(.station-board tbody tr.is-severe) { --row-state-color: var(--color-delay-severe); }
  :global(.station-board tbody tr.is-cancelled), :global(.station-board tbody tr.is-suspended) { --row-state-color: var(--color-text-soft); }
  :global(.station-board tbody tr:hover) { background: color-mix(in srgb, var(--color-primary-soft), transparent 50%); }
  :global(.station-board tbody tr:last-child td) { border-bottom: 0; }
  :global(.journey-link) { display: grid; gap: 0.18rem; color: inherit; text-decoration: none; }
  :global(.journey-link:hover .journey-link__route), :global(.journey-link:focus-visible .journey-link__route) { color: var(--color-primary); text-decoration: underline; }
  :global(.journey-link__route) { display: flex; align-items: baseline; gap: 0.45rem; color: var(--color-text); font-weight: 780; letter-spacing: -0.025em; }
  :global(.journey-link small) { color: var(--color-text-soft); font-size: 0.72rem; }
  :global(.board-time), :global(.train-link) { font-variant-numeric: tabular-nums; font-weight: 780; white-space: nowrap; }
  :global(.train-link) { color: var(--color-text); text-decoration: none; }
  :global(.train-link:hover), :global(.train-link:focus-visible) { color: var(--color-primary); text-decoration: underline; }
  :global(.board-updated) { color: var(--color-text-soft); font-size: 0.75rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  :global(.station-board-empty) { padding: var(--space-6); margin: 0; color: var(--color-text-muted); }

  @media (max-width: 639px) {
    :global(.station-board-wrap) { overflow: visible; border: 0; border-radius: 0; background: transparent; }
    :global(.station-board), :global(.station-board tbody), :global(.station-board tr), :global(.station-board td) { display: block; width: 100%; }
    :global(.station-board thead) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
    :global(.station-board tbody) { display: grid; gap: var(--space-3); }
    :global(.station-board tbody tr) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
    :global(.station-board tbody tr:hover) { background: var(--color-surface); }
    :global(.station-board td) { min-width: 0; padding: var(--space-3) var(--space-4); border: 0; }
    :global(.station-board td::before) { display: block; margin-bottom: 0.18rem; color: var(--color-text-soft); content: attr(data-label); font-size: 0.62rem; font-weight: 750; letter-spacing: 0.07em; text-transform: uppercase; }
    :global(.station-board td:first-child) { grid-column: 1 / -1; padding-block: var(--space-4); border-bottom: 1px solid var(--color-border); }
    :global(.station-board td:first-child::before) { display: none; }
    :global(.station-board td:nth-child(4)) { text-align: right; }
    :global(.station-board td:nth-child(5)) { grid-column: 1 / -1; padding-top: 0; }
    :global(.journey-link__route) { justify-content: space-between; font-size: 1rem; }
    :global(.board-updated) { white-space: normal; }
  }
</style>
