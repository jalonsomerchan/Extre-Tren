---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, siteConfig, type Locale } from '../config/site';
import type { SectionId } from '../config/navigation';
import { useTranslations } from '../i18n/ui';
import { getAbsoluteUrl, stripBasePath, withBasePath } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale?: Locale;
  currentSection?: SectionId;
}

const {
  title = siteConfig.name,
  image = 'og-image.svg',
  locale = defaultLocale,
  currentSection,
} = Astro.props;

const t = useTranslations(locale);
const description = Astro.props.description ?? t('site.description');
const pageTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
const routePath = stripBasePath(Astro.url.pathname);
const canonicalUrl = getAbsoluteUrl(withBasePath(routePath), siteConfig.url);
const imageUrl = getAbsoluteUrl(withBasePath(image), siteConfig.url);
const ogLocale = locale === 'es' ? 'es_ES' : 'en_US';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2457d6" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <script is:inline>
      (() => {
        let savedTheme = null;
        try { savedTheme = localStorage.getItem('extretren-theme'); } catch {}
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = savedTheme ?? (prefersDark ? 'dark' : 'light');
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBasePath('favicon.svg')} />
    <link rel="icon" href={withBasePath('favicon.ico')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBasePath('icons/apple-touch-icon.png')} />
    <link rel="manifest" href={withBasePath('manifest.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body>
    <div class="app-loader" data-app-loader aria-live="polite">
      <div class="app-loader__content">
        <img src={withBasePath('icons/apple-touch-icon.png')} alt="" width="72" height="72" />
        <strong>{siteConfig.name}</strong>
        <span>{t('common.loading')}</span>
        <div class="app-loader__bar" aria-hidden="true"><span></span></div>
      </div>
    </div>
    <noscript><style>[data-app-loader] { display: none; }</style></noscript>
    <a class="skip-link" href="#main">{t('common.skipContent')}</a>
    <Header locale={locale} currentSection={currentSection} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline>
      (() => {
        const loader = document.querySelector('[data-app-loader]');
        const startedAt = performance.now();

        const hideLoader = () => {
          const delay = Math.max(0, 280 - (performance.now() - startedAt));
          window.setTimeout(() => loader?.classList.add('is-ready'), delay);
        };

        if (document.readyState === 'complete') hideLoader();
        else window.addEventListener('load', hideLoader, { once: true });
      })();

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const manifestUrl = document.querySelector('link[rel="manifest"]')?.href;
          if (!manifestUrl) return;

          const serviceWorkerUrl = new URL('sw.js', new URL('./', manifestUrl));
          navigator.serviceWorker.register(serviceWorkerUrl).catch(() => {});
        }, { once: true });
      }

      (() => {
        const refreshInterval = 5 * 60 * 1000;
        let hiddenAt = null;

        const refreshPage = () => {
          if (document.visibilityState === 'visible') window.location.reload();
        };

        window.setInterval(refreshPage, refreshInterval);
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') {
            hiddenAt = Date.now();
            return;
          }

          if (hiddenAt !== null) {
            hiddenAt = null;
            refreshPage();
          }
        });
      })();
    </script>
  </body>
</html>
