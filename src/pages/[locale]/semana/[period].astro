---
import DataPage from '../../../components/DataPage.astro';
import { defaultLocale, locales, type Locale } from '../../../config/site';
import { getAvailableWeeks } from '../../../data/delays';

export function getStaticPaths() {
  return locales.filter((locale) => locale !== defaultLocale)
    .flatMap((locale) => getAvailableWeeks().map((period) => ({ params: { locale, period } })));
}

const locale = Astro.params.locale as Locale;
const period = Astro.params.period!;
---

<DataPage section="week" locale={locale} period={period} />
