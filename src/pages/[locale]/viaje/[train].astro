---
import JourneyHistoryPage from '../../../components/JourneyHistoryPage.astro';
import { defaultLocale, locales, type Locale } from '../../../config/site';
import { getAvailableTrainNumbers } from '../../../data/delays';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .flatMap((locale) => getAvailableTrainNumbers().map((train) => ({ params: { locale, train } })));
}

const locale = Astro.params.locale as Locale;
const trainNumber = Astro.params.train!;
---

<JourneyHistoryPage trainNumber={trainNumber} locale={locale} />
